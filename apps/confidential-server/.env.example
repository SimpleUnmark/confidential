# The web app's content-free receipt endpoint.
APP_RECEIPT_URL=http://host.docker.internal:3000/api/clean/receipt

# Must match the private website's CONFIDENTIAL_SHARED_SECRET.
# Generate with: openssl rand -hex 32
CONFIDENTIAL_SHARED_SECRET=replace-with-at-least-32-random-characters

# Exact browser origins allowed to call this service, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=warning
ATTESTATION_AUDIENCE=https://simpleunmark.com/confidential-workload/v1
REQUIRE_CLIENT_ATTESTATION=0

# Optional, informational only. Security decisions must use attestation claims.
SIMPLEUNMARK_REVISION=
